/**
 * New Clean Question Service
 * 
 * Fast, static question serving with minimal AI dependencies
 */

const QUESTIONS_BASE_URL = process.env.EXPO_PUBLIC_AI_BASE_URL || 'http://localhost:8000';
export interface Question {
  id: string;
  text: string;
  category: string;
  tags?: string[];
  type: 'text' | 'choice' | 'scale';
  options?: string[];
  effectiveness_score?: number;
}

export interface UserProfile {
  age: number;
  profession: string;
  location: string;
  interests: string[];
  personality_type?: string;
}

export interface QuestionsResponse {
  questions: Question[];
  total_count: number;
  cache_hit: boolean;
}

export interface Answer {
  question_id: string;
  answer: string;
  timestamp: string;
}

export interface UserContext {
  user_id: string;
  previous_answers: Answer[];

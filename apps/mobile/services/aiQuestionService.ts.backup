class QuestionService {
  private async makeRequest<T>(
    endpoint: string, 
    method: 'GET' | 'POST' = 'GET', 
    body?: any
  ): Promise<T> {
    try {
      console.log(`📡 API CALL: ${method} ${endpoint}`);
      const startTime = Date.now();
      
      const response = await fetch(`${QUESTIONS_BASE_URL}${endpoint}`, {
        method,
        headers: {
          'Content-Type': 'application/json',
        },
        ...(body && { body: JSON.stringify(body) }),
      });

      const responseTime = Date.now() - startTime;
      console.log(`⚡ RESPONSE TIME: ${responseTime}ms`);

      if (!response.ok) {
        throw new Error(`Questions API Error: ${response.status} - ${response.statusText}`);
      }

      return await response.json();
    } catch (error) {
      console.error('Question Service Error:', error);
      throw error;
    }
  }

  /**
   * Get initial questions for new user - FAST, NO AI
   * No profile needed - just get the basic questions to learn about user
   */
  async getInitialQuestions(): Promise<Question[]> {
    console.log('🚀 INITIAL QUESTIONS: Getting basic questions for new user');
    
    const response = await this.makeRequest<QuestionsResponse>(
      '/api/questions/initial', 
      'GET'
    );
    
    console.log(`✅ RECEIVED: ${response.total_count} questions`);
    return response.questions;
  }

  /**
   * Request question reshuffle - Uses AI when needed
   * Much faster than old system, only calls AI if no cached questions exist
   */
  async requestReshuffle(userId: string, reason: string, userProfile: UserProfile): Promise<Question[]> {
    console.log(`🔄 RESHUFFLE REQUEST: "${reason}"`);
    
    const response = await this.makeRequest<QuestionsResponse>(
      '/api/questions/reshuffle',
      'POST',
      {
        user_id: userId,
        reason: reason,
        user_profile: userProfile
      }
    );
    
    console.log(`✨ RESHUFFLE COMPLETE: ${response.total_count} personalized questions`);
    return response.questions;
  }

  /**
   * Update question effectiveness based on match outcomes
   * Helps improve future question selection
   */
  async updateMatchOutcome(
    questionId: string, 
    userProfile: UserProfile,
    matchSuccess: boolean, 
    matchScore: number
  ): Promise<void> {
    try {
      console.log(`📊 MATCH OUTCOME: ${questionId} - ${matchSuccess ? 'SUCCESS' : 'FAILED'}`);
      
      await this.makeRequest('/api/questions/effectiveness', 'POST', {
        question_id: questionId,
        user_profile: userProfile,
        match_success: matchSuccess,
        match_score: matchScore
      });
    } catch (error) {
      console.warn('Failed to update question effectiveness:', error);
      // Don't throw - this is background analytics
    }
  }

  /**
   * Health check for question service
   */
  async healthCheck(): Promise<boolean> {
    try {
      await this.makeRequest('/api/questions/health');
      return true;
    } catch {
      return false;
    }
  }

  /**
   * Get question service statistics (for debugging)
   */
  async getStats(): Promise<any> {
    try {
      return await this.makeRequest('/api/questions/stats');
    } catch (error) {
      console.warn('Failed to get question stats:', error);
      return null;
    }
  }

  /**
   * Process answer and get next question (simplified for static questions)
   * For now, just return empty array since we're using static question flow
   */
  async processAnswerAndGetNext(
    questionId: string,
    questionText: string, 
    answer: string,
    userContext: UserContext
  ): Promise<{ nextQuestions: Question[] }> {
    console.log(`📝 ANSWER PROCESSED: ${questionId} = "${answer}"`);
    
    // For static questions, we don't generate new questions dynamically
    // The mobile app will handle question flow locally
    return {
      nextQuestions: []
    };
  }
}

// Singleton instance  
export const aiQuestionService = new QuestionService();
export const questionService = aiQuestionService; // For backward compatibility
export default aiQuestionService;


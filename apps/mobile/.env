# FLIO Mobile App Environment Configuration
# AI Backend URL - Update this based on your development setup

# For development (works with iOS Simulator, Android Emulator, physical devices, and Expo Go)
EXPO_PUBLIC_AI_BASE_URL=http://172.30.1.28:8000

# Alternative URLs for different development scenarios:
# For iOS Simulator only: 
# EXPO_PUBLIC_AI_BASE_URL=http://localhost:8000

# For Android Emulator only: 
# EXPO_PUBLIC_AI_BASE_URL=http://10.0.2.2:8000

# For Expo tunnel/ngrok (if using physical device with tunnel):
# EXPO_PUBLIC_AI_BASE_URL=https://your-ngrok-url.ngrok.io

# For production (Modal.com cloud deployment)
# EXPO_PUBLIC_AI_BASE_URL=https://your-modal-deployment-url.com

# Note: If 172.30.1.28 doesn't work for you, find your machine's IP with:
# macOS/Linux: ifconfig | grep "inet " | grep -v 127.0.0.1
# Windows: ipconfig
# FLIO AI Dating App Backend - Environment Configuration
# Copy this file to .env and fill in your actual values

# =your_key_here
# Supabase Database Configuration (New API Key Format)
# =your_key_here
SUPABASE_URL=your_key_here
# Backend currently using anon key (working) - should upgrade to service_role key for production
SUPABASE_SECRET_KEY=your_key_here

# =your_key_here
# Azure OpenAI Configuration (Single Resource)
# =your_key_here
# Both models deployed on amber-mk0td503-eastus2
AZURE_OPENAI_ENDPOINT=your_key_here
AZURE_OPENAI_API_KEY=your_key_here
AZURE_OPENAI_API_VERSION=your_key_here

# =your_key_here
# Azure Translator Configuration (Cost Optimization)
# =your_key_here
# Used to translate Korean text to English before embedding generation
# Reduces token costs by ~60%
AZURE_TRANSLATOR_ENDPOINT=your_key_here
AZURE_TRANSLATOR_KEY=your_key_here
AZURE_TRANSLATOR_REGION=your_key_here

# Model Deployments (both on same resource)
AZURE_OPENAI_EMBEDDING_MODEL=your_key_here
AZURE_OPENAI_CHAT_MODEL=your_key_here
AZURE_OPENAI_CHAT_MODEL_VISION=your_key_here
AZURE_OPENAI_WHISPER_MODEL=whisper-1

# =your_key_here
# Alternative: OpenAI Direct API (if not using Azure)
# =your_key_here
# OPENAI_API_KEY=your_key_here
# OPENAI_ORG_ID=your_key_here

# =your_key_here
# Redis Configuration (Required for performance)
# =your_key_here
REDIS_URL=your_key_here
REDIS_PASSWORD=your_key_here
REDIS_DB=your_key_here


# =your_key_here
# FastAPI Server Configuration
# =your_key_here
ENVIRONMENT=your_key_here
HOST=your_key_here
PORT=your_key_here
RELOAD=your_key_here
LOG_LEVEL=your_key_here

# Performance Settings
MAX_WORKERS=your_key_here
WORKERS_PER_CORE=your_key_here
WEB_CONCURRENCY=your_key_here
KEEP_ALIVE=your_key_here
TIMEOUT_KEEP_ALIVE=your_key_here

# =your_key_here
# Security & Rate Limiting
# =your_key_here
SECRET_KEY=your_key_here
ALGORITHM=your_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=your_key_here

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=your_key_here
RATE_LIMIT_PER_HOUR=your_key_here



# =your_key_here
# Development Settings
# =your_key_here
DEBUG=your_key_here

# Database Connection Pool
DB_POOL_SIZE=your_key_here
DB_MAX_OVERFLOW=your_key_here
DB_POOL_TIMEOUT=your_key_here
DB_POOL_RECYCLE=your_key_here


# =your_key_here
# Optional: Local PostgreSQL (if not using Supabase)
# =your_key_here
# POSTGRES_PASSWORD=your_key_here
# DATABASE_URL=your_key_here
